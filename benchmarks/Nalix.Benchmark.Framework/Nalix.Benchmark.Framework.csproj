<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);CA1822;CA2007;CA1051;CA1001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="MessagePack" Version="3.1.4" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
		<PackageReference Include="Nalix.Abstractions" Version="12.3.0" />
		<PackageReference Include="Nalix.Codec" Version="12.3.0" />
		<PackageReference Include="Nalix.Environment" Version="12.3.0" />
		<PackageReference Include="Nalix.Framework" Version="12.3.0" />
		<PackageReference Include="Nalix.Hosting" Version="12.3.0" />
		<PackageReference Include="Nalix.Logging" Version="12.3.0" />
		<PackageReference Include="Nalix.Runtime" Version="12.3.0" />
		<PackageReference Include="Nalix.SDK" Version="12.3.0" />

	</ItemGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<Optimize>true</Optimize>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

</Project>
