@namespace Nalix.Dashboard.Components.Layout
@inherits LayoutComponentBase
@inject IDashboardStateReader State
@inject IAdminSettingsStore SettingsStore
@inject IAdminClient Client
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="Toggle navigation" />

        <a href="/" class="nalix-brand">
            <img src="assets/brand/dashboard.png" alt="" class="nalix-brand__logo" />
            <span class="nalix-brand__name">Nalix Admin</span>
        </a>

        <MudSpacer />

        @if (State.HasApiKey)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(State.IsConnected ? Color.Success : Color.Error)"
                     Variant="Variant.Filled"
                     Class="mr-1">
                @(State.IsConnected ? "Connected" : "Disconnected")
            </MudChip>

            @if (State.LastPingMilliseconds is { } ms)
            {
                <MudText Typo="Typo.caption" Color="Color.Inherit" Class="mr-2">
                    @ms.ToString("F0") ms
                </MudText>
            }
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="mr-1">
                No Key
            </MudChip>
        }

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme"
                       Title="@(_isDarkMode ? "Light mode" : "Dark mode")" />

        @if (State.HasApiKey)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.Logout"
                           Color="Color.Inherit"
                           OnClick="LogoutAsync"
                           Title="Logout" />
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="1"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Never">
        <MudDrawerHeader Dense="true">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Menu</MudText>
        </MudDrawerHeader>
        <AdminNavMenu />
    </MudDrawer>

    <MudMainContent Class="nalix-main">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode = true;
    private bool _drawerOpen = true;
    private bool _sessionRestored;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0969da",
            Secondary = "#1f883d",
            Tertiary = "#8250df",
            Success = "#1a7f37",
            Warning = "#9a6700",
            Error = "#cf222e",
            Info = "#0969da",
            AppbarBackground = "#ffffff",
            AppbarText = "#1f2328",
            Background = "#f6f8fa",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            TextPrimary = "#1f2328",
            TextSecondary = "#57606a",
            Divider = "#d0d7de"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#2f81f7",
            Secondary = "#3fb950",
            Tertiary = "#a371f7",
            Success = "#3fb950",
            Warning = "#d29922",
            Error = "#f85149",
            Info = "#58a6ff",
            AppbarBackground = "#010409",
            AppbarText = "#f0f6fc",
            Background = "#0d1117",
            Surface = "#161b22",
            DrawerBackground = "#0d1117",
            TextPrimary = "#f0f6fc",
            TextSecondary = "#8b949e",
            Divider = "#30363d"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionRestored) return;
        _sessionRestored = true;

        AdminSettings settings = await SettingsStore.LoadAsync().ConfigureAwait(false);
        _isDarkMode = settings.ThemeMode != ThemeMode.Light;

        string? savedKey = await SettingsStore.GetApiKeyAsync().ConfigureAwait(false);
        savedKey ??= DevDashboardKey.IsConfigured ? DevDashboardKey.ApiKey : null;
        if (!string.IsNullOrWhiteSpace(savedKey))
        {
            await Client.SetApiKeyAsync(savedKey).ConfigureAwait(false);
        }

        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    private async Task LogoutAsync()
    {
        await Client.SetApiKeyAsync(string.Empty).ConfigureAwait(false);
        await SettingsStore.ClearApiKeyAsync().ConfigureAwait(false);
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
    }
}
