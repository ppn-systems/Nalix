@using Dashboard.Presentation.ReportValues

@switch (Model.Kind)
{
    case ParsedReportValueKind.Empty:
        <span class="value-empty">-</span>
        break;
    case ParsedReportValueKind.Scalar:
        <span class="@ValueClass(Model.Raw)">@FormatValue(Model.Raw)</span>
        break;
    case ParsedReportValueKind.Fields:
        <dl class="kv-grid">
            @foreach (ParsedReportField field in Model.Fields)
            {
                <div class="kv-item">
                    <dt class="kv-name">@ReportValueParser.DisplayName(field.Name)</dt>
                    <dd class="@ValueClass(field.Value)">@FormatValue(field.Value)</dd>
                </div>
            }
        </dl>
        break;
    case ParsedReportValueKind.Records:
        ReportRecordLayout recordLayout = ReportRecordLayoutBuilder.Build(Model.Records);
        <ReportRecordChart ReportKey="@ReportKey"
                           Records="Model.Records" />
        <div class="@RecordListClass(recordLayout)">
            @foreach (ReportRecordItem record in recordLayout.Records)
            {
                <article class="@RecordCardClass(record)">
                    <header class="record-header">
                        <span class="record-title">@record.Title</span>
                    </header>
                    <dl class="record-fields">
                        @foreach (ReportRecordFieldItem field in record.Fields)
                        {
                            <div class="@FieldClass(field)">
                                <dt class="record-name">@field.Label</dt>
                                <dd class="@ValueClass(field.RawValue)">@field.Value</dd>
                            </div>
                        }
                    </dl>
                </article>
            }
        </div>
        break;
    case ParsedReportValueKind.Items:
        <div class="text-list">
            @foreach (string item in Model.Items)
            {
                <div class="@ValueClass(item)">@FormatValue(item)</div>
            }
        </div>
        break;
}

@code {
    [Parameter]
    public string ReportKey { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public ParsedReportValue Model { get; set; } = ParsedReportValue.Empty;

    private static string RecordListClass(ReportRecordLayout layout)
        => layout.HasCompactRecords
            ? "record-list has-compact-records"
            : "record-list";

    private static string RecordCardClass(ReportRecordItem record)
        => record.IsCompact
            ? "record-card is-compact"
            : "record-card";

    private static string FieldClass(ReportRecordFieldItem field)
        => field.IsWide
            ? "record-field is-wide"
            : "record-field";

    private static string ValueClass(string value)
    {
        string cssClass = "report-value";

        if (ReportValueFormatter.IsDateValue(value))
        {
            cssClass += " is-date";
        }
        else if (ReportValueFormatter.IsBooleanValue(value))
        {
            cssClass += " is-bool";
        }
        else if (ReportValueFormatter.IsCodeValue(value))
        {
            cssClass += " is-code";
        }

        return cssClass;
    }

    private static string FormatValue(string value)
        => ReportValueFormatter.Format(value);
}
