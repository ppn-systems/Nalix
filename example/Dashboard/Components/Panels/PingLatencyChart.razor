@namespace Dashboard.Components.Panels
@using Dashboard.Domain.Metrics
@using Dashboard.Presentation
@using Dashboard.Presentation.Metrics

<section class="chart-panel" aria-label="Latency chart">
    <div class="chart-head">
        <div>
            <span class="section-label">Latency trend</span>
            <strong>@DashboardDisplay.FormatPing(LastPingMilliseconds)</strong>
        </div>
        <span>@Samples.Count samples</span>
    </div>
    <div class="ping-chart">
        @if (HasChart)
        {
            <svg viewBox="0 0 320 96" preserveAspectRatio="none" role="img" aria-label="Ping latency over time">
                <line x1="0" y1="16" x2="320" y2="16" />
                <line x1="0" y1="48" x2="320" y2="48" />
                <line x1="0" y1="80" x2="320" y2="80" />
                <polyline points="@ChartPoints" />
            </svg>
        }
        else
        {
            <div class="chart-empty">Waiting for ping samples</div>
        }
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<DashboardPingSample> Samples { get; set; } = [];

    [Parameter]
    public double? LastPingMilliseconds { get; set; }

    private bool HasChart => Samples.Count > 1;

    private string ChartPoints => PingChartPointBuilder.Build(Samples);
}
