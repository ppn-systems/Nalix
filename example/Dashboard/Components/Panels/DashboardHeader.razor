@namespace Dashboard.Components.Panels
@using Contracts
@using Dashboard.Presentation

<div class="header-copy">
    <div class="header-kicker">Runtime observability</div>
    <h1 class="dashboard-title">Operations Console</h1>
    <div class="header-meta">
        <span class="@ConnectionPillClass">
            <span class="status-dot"></span>
            @(IsConnected ? "Connected" : "Disconnected")
        </span>
        <span>@BackendEndpoint</span>
        <span>@DashboardDisplay.TargetLabel(SelectedReportTarget)</span>
    </div>
</div>

@code {
    [Parameter]
    public bool IsConnected { get; set; }

    [Parameter]
    public string BackendEndpoint { get; set; } = string.Empty;

    [Parameter]
    public GenerationReportTarget? SelectedReportTarget { get; set; }

    private string ConnectionPillClass => IsConnected ? "status-pill is-connected" : "status-pill is-disconnected";
}
