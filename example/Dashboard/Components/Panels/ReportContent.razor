@namespace Dashboard.Components.Panels
@using Contracts
@using Dashboard.Domain.Logs
@using Dashboard.Domain.Reports
@using Dashboard.Presentation
@using Dashboard.Presentation.ReportValues

<section class="report-content">
    <div class="report-content-head">
        <div>
            <span class="section-label">Selected view</span>
            <h2>@ContentHeadLabel</h2>
        </div>
    </div>

    @if (IsConfigView)
    {
        <div class="report-panel config-panel">
            <div class="config-section">
                <h3>Connection</h3>
                <div class="config-fields">
                    <div class="config-field">
                        <label>Backend address</label>
                        <MudTextField T="string"
                                      Value="BackendAddress"
                                      ValueChanged="BackendAddressChanged"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="127.0.0.1" />
                    </div>
                    <div class="config-field">
                        <label>Backend port</label>
                        <MudNumericField T="int"
                                         Value="BackendPort"
                                         ValueChanged="BackendPortChanged"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1"
                                         Max="65535"
                                         Step="1" />
                    </div>
                </div>
            </div>
            <div class="config-section">
                <h3>Polling</h3>
                <div class="config-fields">
                    <div class="config-field">
                        <label>Poll interval (ms)</label>
                        <MudNumericField T="int"
                                         Value="PollIntervalMs"
                                         ValueChanged="PollIntervalChanged"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="100"
                                         Max="10000"
                                         Step="100" />
                        <small>@DashboardDisplay.FormatPollingRate(PollIntervalMs)</small>
                    </div>
                    <div class="config-field">
                        <label>Ping interval (ms)</label>
                        <MudNumericField T="int"
                                         Value="PingIntervalMs"
                                         ValueChanged="PingIntervalChanged"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1000"
                                         Max="30000"
                                         Step="500" />
                    </div>
                    <div class="config-field">
                        <label>Request timeout (ms)</label>
                        <MudNumericField T="int"
                                         Value="RequestTimeoutMs"
                                         ValueChanged="RequestTimeoutChanged"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1000"
                                         Max="30000"
                                         Step="1000" />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (SelectedReportTarget is { } selectedTarget)
    {
        @if (Reports.TryGetValue(selectedTarget, out DashboardReportSnapshot? report))
        {
            <div class="report-panel">
                <div class="report-meta-grid">
                    <div>
                        <span>Reason</span>
                        <strong>@report.Reason</strong>
                    </div>
                    <div>
                        <span>Received</span>
                        <strong>@DashboardDisplay.FormatTime(report.ReceivedAt)</strong>
                    </div>
                    <div>
                        <span>Fields</span>
                        <strong>@report.Data.Count</strong>
                    </div>
                </div>

                @if (report.Data.Count == 0)
                {
                    <div class="empty-inline">No report fields returned.</div>
                }
                else
                {
                    ReportMetricLayout layout = ReportMetricLayoutBuilder.Build(OrderedRows(report));

                    @if (layout.MetricGroups.Count > 0)
                    {
                        <div class="metric-groups">
                            @foreach (ReportMetricGroup group in layout.MetricGroups)
                            {
                                <section class="metric-group" aria-label="@group.Name">
                                    <header class="metric-group-head">
                                        <span>@group.Name</span>
                                        <strong>@group.Items.Count</strong>
                                    </header>
                                    <div class="metric-grid">
                                        @foreach (ReportMetricItem metric in group.Items)
                                        {
                                            <article class="metric-card">
                                                <span class="metric-label">@metric.Label</span>
                                                <strong class="@MetricValueClass(metric)">@metric.Value</strong>
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }

                    @if (layout.DetailRows.Count > 0)
                    {
                        <div class="report-rows">
                            @foreach (ReportDetailRow row in layout.DetailRows)
                            {
                                <section class="@ReportRowClass(row.ParsedValue)">
                                    <div class="report-row-key">@ReportValueParser.DisplayName(row.Key)</div>
                                    <div class="report-row-value">
                                        <ReportValueView ReportKey="@row.Key"
                                                         Model="row.ParsedValue" />
                                    </div>
                                </section>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="empty-panel">Waiting for @DashboardDisplay.TargetLabel(selectedTarget) data...</div>
        }
    }
    else
    {
        <div class="log-panel" id="logs">
            <div class="log-toolbar">
                <span class="muted">@Logs.Count log entries</span>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           OnClick="() => ClearLogs.InvokeAsync()">
                    Clear
                </MudButton>
            </div>
            <textarea class="log-output" readonly>@LogText</textarea>
        </div>
    }
</section>

@code {
    [Parameter]
    public bool IsConfigView { get; set; }

    [Parameter]
    public GenerationReportTarget? SelectedReportTarget { get; set; }

    [Parameter]
    public IReadOnlyDictionary<GenerationReportTarget, DashboardReportSnapshot> Reports { get; set; } =
        new Dictionary<GenerationReportTarget, DashboardReportSnapshot>();

    [Parameter]
    public IReadOnlyList<DashboardLogEntry> Logs { get; set; } = [];

    [Parameter]
    public EventCallback ClearLogs { get; set; }

    [Parameter]
    public string BackendAddress { get; set; } = "127.0.0.1";

    [Parameter]
    public int BackendPort { get; set; } = 57206;

    [Parameter]
    public EventCallback<string> BackendAddressChanged { get; set; }

    [Parameter]
    public EventCallback<int> BackendPortChanged { get; set; }

    [Parameter]
    public int PollIntervalMs { get; set; }

    [Parameter]
    public int PingIntervalMs { get; set; }

    [Parameter]
    public int RequestTimeoutMs { get; set; }

    [Parameter]
    public EventCallback<int> PollIntervalChanged { get; set; }

    [Parameter]
    public EventCallback<int> PingIntervalChanged { get; set; }

    [Parameter]
    public EventCallback<int> RequestTimeoutChanged { get; set; }

    private string ContentHeadLabel
    {
        get
        {
            if (IsConfigView) return "Config";
            return DashboardDisplay.TargetLabel(SelectedReportTarget);
        }
    }

    private string LogText => string.Join(Environment.NewLine, Logs.Select(static entry =>
        $"[{entry.Timestamp.ToLocalTime():HH:mm:ss.fff}] [{entry.Level}] {entry.Message}"));

    private static IEnumerable<KeyValuePair<string, object?>> OrderedRows(DashboardReportSnapshot report)
        => report.Data.OrderBy(static x => x.Key, StringComparer.Ordinal);

    private static string ReportRowClass(ParsedReportValue value)
        => value.IsWide ? "report-row is-wide" : "report-row";

    private static string MetricValueClass(ReportMetricItem metric)
    {
        string cssClass = "metric-value";
        cssClass += " is-" + metric.Kind.ToString().ToLowerInvariant();

        if (metric.Kind == ReportMetricKind.Boolean)
        {
            cssClass += metric.RawValue.Equals("true", StringComparison.OrdinalIgnoreCase)
                ? " is-true"
                : " is-false";
        }

        return cssClass;
    }
}
