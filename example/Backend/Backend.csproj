<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Backend</RootNamespace>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

		<ApplicationIcon>app.ico</ApplicationIcon>

		<Optimize>true</Optimize>
		<TieredCompilation>true</TieredCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Nalix.SDK" Version="12.5.0" />
		<PackageReference Include="Nalix.Logging" Version="12.5.0" />
		<PackageReference Include="Nalix.Network" Version="12.5.0" />
		<PackageReference Include="Nalix.Runtime" Version="12.5.0" />
		<PackageReference Include="Nalix.Hosting" Version="12.5.0" />
		<PackageReference Include="Nalix.Framework" Version="12.5.0" />
		
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Nalix.Observability.Contracts">
			<HintPath>..\dll\Nalix.Observability.Contracts.dll</HintPath>
		</Reference>
		<Reference Include="Nalix.Observability.Handlers">
			<HintPath>..\dll\Nalix.Observability.Handlers.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
