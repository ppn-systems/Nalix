@using Nalix.Examples.Contracts

<div class="dashboard-actions action-panel" id="dashboard-config">
    <div class="action-panel-heading">
        <span>Config</span>
        <strong>Backend access</strong>
    </div>
    <MudTextField T="string"
                  Value="@ApiKey"
                  ValueChanged="OnApiKeyChanged"
                  Placeholder="API key"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  InputType="InputType.Password"
                  Immediate="true"
                  Class="api-key-input" />
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Disabled="SavingKey"
               OnClick="() => SaveRequested.InvokeAsync()">
        Use key
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="@(IsPollingPaused ? Color.Primary : Color.Default)"
               OnClick="() => PauseToggled.InvokeAsync()">
        @(IsPollingPaused ? "Resume" : "Pause")
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="Refreshing || !HasApiKey || SelectedReportTarget is null"
               OnClick="() => RefreshRequested.InvokeAsync()">
        Refresh
    </MudButton>

    <div class="action-panel-heading" style="margin-top:12px">
        <span>Intervals</span>
        <strong>Tuning</strong>
    </div>
    <MudNumericField T="int"
                     Value="PollIntervalMs"
                     ValueChanged="OnPollIntervalChanged"
                     Label="Poll (ms)"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Min="100"
                     Max="10000"
                     Step="100" />
    <MudNumericField T="int"
                     Value="PingIntervalMs"
                     ValueChanged="OnPingIntervalChanged"
                     Label="Ping (ms)"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Min="1000"
                     Max="30000"
                     Step="500" />
    <MudNumericField T="int"
                     Value="RequestTimeoutMs"
                     ValueChanged="OnRequestTimeoutChanged"
                     Label="Timeout (ms)"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Min="1000"
                     Max="30000"
                     Step="1000" />
</div>

@code {
    [Parameter]
    public string? ApiKey { get; set; }

    [Parameter]
    public EventCallback<string?> ApiKeyChanged { get; set; }

    [Parameter]
    public bool SavingKey { get; set; }

    [Parameter]
    public bool IsPollingPaused { get; set; }

    [Parameter]
    public bool Refreshing { get; set; }

    [Parameter]
    public bool HasApiKey { get; set; }

    [Parameter]
    public GenerationReportTarget? SelectedReportTarget { get; set; }

    [Parameter]
    public int PollIntervalMs { get; set; }

    [Parameter]
    public int PingIntervalMs { get; set; }

    [Parameter]
    public int RequestTimeoutMs { get; set; }

    [Parameter]
    public EventCallback SaveRequested { get; set; }

    [Parameter]
    public EventCallback PauseToggled { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback<int> PollIntervalChanged { get; set; }

    [Parameter]
    public EventCallback<int> PingIntervalChanged { get; set; }

    [Parameter]
    public EventCallback<int> RequestTimeoutChanged { get; set; }

    private Task OnApiKeyChanged(string? value) => ApiKeyChanged.InvokeAsync(value);

    private Task OnPollIntervalChanged(int value) => PollIntervalChanged.InvokeAsync(value);

    private Task OnPingIntervalChanged(int value) => PingIntervalChanged.InvokeAsync(value);

    private Task OnRequestTimeoutChanged(int value) => RequestTimeoutChanged.InvokeAsync(value);
}
