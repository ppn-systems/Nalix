@using Nalix.Examples.Contracts.Packets
@using Nalix.Examples.Dashboard.Presentation

<section class="status-overview" aria-label="Dashboard status">
    <DashboardMetricTile StateClass="@(IsConnected ? "is-good" : "is-bad")"
                         Label="TCP status"
                         Value="@(IsConnected ? "Online" : "Offline")"
                         Detail="@(IsPollingPaused ? "Polling paused" : "Polling active")" />
    <DashboardMetricTile StateClass="@DashboardDisplay.PingStateClass(LastPingMilliseconds)"
                         Label="Ping RTT"
                         Value="@DashboardDisplay.FormatPing(LastPingMilliseconds)"
                         Detail="@DashboardDisplay.FormatTime(LastPingAt)" />
    <DashboardMetricTile StateClass="@(HasApiKey ? "is-good" : "is-muted")"
                         Label="Authority"
                         Value="@(HasApiKey ? "Key ready" : "Key required")"
                         Detail="System administrator" />
    <DashboardMetricTile StateClass="is-info"
                         Label="Last refresh"
                         Value="@DashboardDisplay.FormatTime(LastRefreshAt)"
                         Detail="@DashboardDisplay.TargetLabel(SelectedReportTarget)" />
    <DashboardMetricTile StateClass="is-accent"
                         Label="Reports"
                         Value="@($"{ReportCount} / {TargetCount}")"
                         Detail="Loaded snapshots" />
</section>

@code {
    [Parameter]
    public bool IsConnected { get; set; }

    [Parameter]
    public bool IsPollingPaused { get; set; }

    [Parameter]
    public double? LastPingMilliseconds { get; set; }

    [Parameter]
    public DateTimeOffset? LastPingAt { get; set; }

    [Parameter]
    public bool HasApiKey { get; set; }

    [Parameter]
    public DateTimeOffset? LastRefreshAt { get; set; }

    [Parameter]
    public GenerationReportTarget? SelectedReportTarget { get; set; }

    [Parameter]
    public int ReportCount { get; set; }

    [Parameter]
    public int TargetCount { get; set; }
}
