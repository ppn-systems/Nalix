@using Nalix.Examples.Dashboard.Presentation.ReportValues

@switch (Model.Kind)
{
    case ParsedReportValueKind.Empty:
        <span class="value-empty">-</span>
        break;
    case ParsedReportValueKind.Scalar:
        <span class="@ValueClass(Model.Raw)">@FormatValue(Model.Raw)</span>
        break;
    case ParsedReportValueKind.Fields:
        <dl class="kv-grid">
            @foreach (ParsedReportField field in Model.Fields)
            {
                <div class="kv-item">
                    <dt class="kv-name">@ReportValueParser.DisplayName(field.Name)</dt>
                    <dd class="@ValueClass(field.Value)">@FormatValue(field.Value)</dd>
                </div>
            }
        </dl>
        break;
    case ParsedReportValueKind.Records:
        <div class="record-list">
            @foreach (ParsedReportRecord record in Model.Records)
            {
                <article class="record-card">
                    <header class="record-header">
                        <span class="record-title">@FormatValue(record.Title)</span>
                    </header>
                    <dl class="record-fields">
                        @foreach (ParsedReportField field in record.Fields)
                        {
                            @if (ShouldRenderField(record, field))
                            {
                                <div class="@FieldClass(field)">
                                    <dt class="record-name">@ReportValueParser.DisplayName(field.Name)</dt>
                                    <dd class="@ValueClass(field.Value)">@FormatValue(field.Value)</dd>
                                </div>
                            }
                        }
                    </dl>
                </article>
            }
        </div>
        break;
    case ParsedReportValueKind.Items:
        <div class="text-list">
            @foreach (string item in Model.Items)
            {
                <div class="@ValueClass(item)">@FormatValue(item)</div>
            }
        </div>
        break;
}

@code {
    [Parameter, EditorRequired]
    public ParsedReportValue Model { get; set; } = ParsedReportValue.Empty;

    private static bool ShouldRenderField(ParsedReportRecord record, ParsedReportField field)
        => !IsDuplicateRecordTitle(record.Title, field);

    private static string FieldClass(ParsedReportField field)
    {
        string name = field.Name;
        return IsLongValue(field.Value) || IsDateField(name, field.Value)
            ? "record-field is-wide"
            : "record-field";
    }

    private static string ValueClass(string value)
    {
        string cssClass = "report-value";

        if (IsDateValue(value))
        {
            cssClass += " is-date";
        }
        else if (IsBooleanValue(value))
        {
            cssClass += " is-bool";
        }
        else if (IsCodeValue(value))
        {
            cssClass += " is-code";
        }

        return cssClass;
    }

    private static string FormatValue(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        string trimmed = value.Trim();
        if (DateTimeOffset.TryParse(
            trimmed,
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal,
            out DateTimeOffset parsed))
        {
            return parsed.ToUniversalTime().ToString(
                "yyyy-MM-dd HH:mm:ss 'UTC'",
                System.Globalization.CultureInfo.InvariantCulture);
        }

        return trimmed;
    }

    private static bool IsDuplicateRecordTitle(string title, ParsedReportField field)
        => field.Name is "Name" or "Id" or "ID" &&
           title.Equals(field.Value, StringComparison.OrdinalIgnoreCase);

    private static bool IsDateField(string name, string value)
        => name.Contains("Utc", StringComparison.OrdinalIgnoreCase) || IsDateValue(value);

    private static bool IsDateValue(string value)
        => value.Contains('T', StringComparison.Ordinal) &&
           DateTimeOffset.TryParse(
               value,
               System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.AssumeUniversal,
               out _);

    private static bool IsBooleanValue(string value)
        => bool.TryParse(value, out _);

    private static bool IsCodeValue(string value)
        => value.Length >= 12 && value.All(static c => Uri.IsHexDigit(c));

    private static bool IsLongValue(string value)
        => value.Length > 28;
}
