<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsRoslynComponent>true</IsRoslynComponent>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TargetFramework>netstandard2.0</TargetFramework>
		<PublishAot Condition="'$(MSBuildProjectName)' == 'Nalix.AutoGenerated'">false</PublishAot>
		<PublishTrimmed Condition="'$(MSBuildProjectName)' == 'Nalix.AutoGenerated'">false</PublishTrimmed>
		<IsTrimmable Condition="'$(MSBuildProjectName)' == 'Nalix.AutoGenerated'">false</IsTrimmable>
		<IsAotCompatible Condition="'$(MSBuildProjectName)' == 'Nalix.AutoGenerated'">false</IsAotCompatible>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all" />
	</ItemGroup>
</Project>
