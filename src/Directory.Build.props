<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Version.props') AND '$(Version)' == ''" />

	<PropertyGroup>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Auto-define NALIX_AOT when Native AOT publishing is enabled -->
	<PropertyGroup Condition="'$(PublishAot)' == 'true'">
		<DefineConstants>$(DefineConstants);NALIX_AOT</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>embedded</DebugType>
		<IncludeSource>false</IncludeSource>
		<IncludeSymbols>false</IncludeSymbols>
		<PublishRepositoryUrl>false</PublishRepositoryUrl>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
	  
		<OutputPath>..\..\build\bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>
		<BaseIntermediateOutputPath>..\..\build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<Deterministic>true</Deterministic>
		<TieredCompilation>true</TieredCompilation>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<MaxParallelProjectBuilds>4</MaxParallelProjectBuilds>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

		<OutputPath>..\..\build\bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>
		<BaseIntermediateOutputPath>..\..\build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>

		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<FileVersion Condition="'$(FileVersion)' == ''">$(Version).0</FileVersion>
		<InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)+$(SourceRevisionId)</InformationalVersion>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(PublishAot)' != 'true' And '$(DisableNalixAnalyzers)' != 'true' And '$(MSBuildProjectName)' != 'Nalix.Analyzers' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Tests'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Nalix.Analyzers\Nalix.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)Nalix.Analyzers.CodeFixes\Nalix.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable" />
	</ItemGroup>

	<!-- Source generator for ConfigurationLoader AOT binding -->
	<ItemGroup Condition="'$(PublishAot)' != 'true' And '$(MSBuildProjectName)' != 'Nalix.Analyzers' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Tests' And '$(MSBuildProjectName)' != 'Nalix.AutoGenerated' And '$(MSBuildProjectName)' != 'Nalix.Abstractions'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Nalix.AutoGenerated\Nalix.AutoGenerated.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" AdditionalProperties="PublishAot=false;PublishTrimmed=false;IsTrimmable=false;IsAotCompatible=false" />
	</ItemGroup>

</Project>
