<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Version.props') AND '$(Version)' == ''" />

	<PropertyGroup>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
	</PropertyGroup>

	<!-- Auto-define NALIX_AOT when Native AOT publishing is enabled -->
	<PropertyGroup Condition="'$(PublishAot)' == 'true'">
		<DefineConstants>$(DefineConstants);NALIX_AOT</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>embedded</DebugType>
		<IncludeSource>false</IncludeSource>
		<IncludeSymbols>false</IncludeSymbols>
		<PublishRepositoryUrl>false</PublishRepositoryUrl>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<OutputPath>$(MSBuildThisFileDirectory)..\build\bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<Deterministic>true</Deterministic>
		<TieredCompilation>true</TieredCompilation>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<UseSharedCompilation Condition="'$(ContinuousIntegrationBuild)' == 'true'">false</UseSharedCompilation>
		<GenerateDepsFile Condition="'$(OutputType)' == 'Library'">false</GenerateDepsFile>
		<OutputPath>$(MSBuildThisFileDirectory)..\build\bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>

		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<FileVersion Condition="'$(FileVersion)' == ''">$(Version).0</FileVersion>
		<InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)+$(SourceRevisionId)</InformationalVersion>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(PublishAot)' != 'true' And '$(DisableNalixAnalyzers)' != 'true' And '$(MSBuildProjectName)' != 'Nalix.Analyzers' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Tests'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\analyzers\Nalix.Analyzers\Nalix.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\analyzers\Nalix.Analyzers.CodeFixes\Nalix.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" />
	</ItemGroup>

	<!-- Source generator for ConfigurationLoader AOT binding -->
	<ItemGroup Condition="'$(PublishAot)' != 'true' And '$(MSBuildProjectName)' != 'Nalix.Analyzers' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Tests' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Generators' And '$(MSBuildProjectName)' != 'Nalix.Abstractions'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\analyzers\Nalix.Analyzers.Generators\Nalix.Analyzers.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" />
	</ItemGroup>

</Project>
