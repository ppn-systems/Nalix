<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nalix.Abstractions\Nalix.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Nalix.Framework\Nalix.Framework.csproj" />
    <ProjectReference Include="..\..\src\Nalix.Hosting\Nalix.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Nalix.Runtime\Nalix.Runtime.csproj" />
    <ProjectReference Include="..\Nalix.Tunneling.Contracts\Nalix.Tunneling.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

</Project>
