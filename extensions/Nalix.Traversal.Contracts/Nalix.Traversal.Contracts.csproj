<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>

		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<IsTrimmable>false</IsTrimmable>
		<OutputType>Library</OutputType>
		<Deterministic>true</Deterministic>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DisableImplicitMicrosoftCSharpReference>true</DisableImplicitMicrosoftCSharpReference>

		<Description><![CDATA[
Nalix.Traversal.Contracts provides the shared packets, protocols, and client-side utilities (like NatPuncher) for NAT hole punching. 
This lightweight package is intended to be referenced by game clients without pulling in server dependencies.
		]]></Description>

	</PropertyGroup>

	<Import Project="..\..\src\Nalix.Build.props" />
	<Import Project="..\..\src\Package.Build.props" />

	<ItemGroup>
		<ProjectReference Include="..\..\src\Nalix.Abstractions\Nalix.Abstractions.csproj" />
		<ProjectReference Include="..\..\src\Nalix.Codec\Nalix.Codec.csproj" />
		<ProjectReference Include="..\..\src\Nalix.Analyzers.Generators\Nalix.Analyzers.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" />
	</ItemGroup>
</Project>
